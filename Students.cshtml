@using AIS_RubricFeedbackGenerator.Models
@model IEnumerable<AIS_RubricFeedbackGenerator.Models.StudentMarkingViewModel>  
@{  
    ViewData["Title"] = "Students";  
    var assignment = ViewData["Assignment"] as AIS_RubricFeedbackGenerator.Models.Assignment; // Ensure assignment is retrieved from ViewData or another source  
}  

<div class="row">  
    <div class="col-12">  
      <h2><i class="fas fa-users"></i> Students</h2>  

        @if (TempData["Success"] != null)  
        {  
            <div class="alert alert-success alert-dismissible fade show" role="alert">  
                @TempData["Success"]  
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>  
            </div>  
        }  

        <div class="card shadow-sm rounded-3">  
            <div class="card-body">  
                <form asp-action="BulkAction" method="post">  
                    <div class="table-responsive">  
                        <table class="table table-striped table-hover align-middle">  
                            <thead>  
                                <tr>  
                                    
                                    <th>Student ID</th>  
                                    <th>Name</th>  
                                    <th>Email</th>  
                                    <th>Status</th>  
                                    <th>Actions</th>  
                                </tr>  
                            </thead>  
                            <tbody>  
                                @foreach (var student in Model)  
                                {  
                                    <tr>  
                                         
                                        <td>@student.StudentId</td>  
                                        <td>@student.FullName</td>  
                                        <td>@student.Email</td>  
                                        
                                        <td>
                                            @if (student.MarkingStatus == "submitted")
                                            {
                                                <span class="badge bg-success">Submitted</span>
                                            }
                                            else if (student.MarkingStatus == "draft")
                                            {
                                                <span class="badge bg-secondary">Draft</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            }
                                        </td>

                                        
                                        <td>
                                            <a class="btn btn-sm btn-primary"
                                               asp-controller="Marking"
                                               asp-action="Mark"
                                               asp-route-assignmentId="@ViewBag.AssignmentId"
                                               asp-route-studentId="@student.StudentId">
                                                Mark
                                            </a>
                                        </td>  
                                    </tr>  
                                }  
                            </tbody>  
                        </table>  
                    </div>  
                </form>  
            </div>  
        </div>  
    </div>  
</div>  


